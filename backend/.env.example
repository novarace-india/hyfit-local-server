# HYFIT local backend — copy to .env and adjust. Every variable the copied
# source actually reads is listed here; there are no others.

NODE_ENV=development
PORT=3001

# ── Postgres ────────────────────────────────────────────────────────────────
# Both HYFIT modules open their own pg pool against this database. The
# hyfitgames pool pins every connection to `search_path=hyfit,public`; the
# hyfit-judge pool reads the `hyfit_v2` schema. So one local database carrying
# both schemas is all this needs — see sql/hyfit_schema.sql and
# sql/hyfit_v2_schema.sql.
#
# DB_PASSWORD is the one variable with no fallback: the pool throws on startup
# if it is unset. An empty value is fine for a trust-auth local Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hyfit_local
# When true, TLS is required and db-ca.pem (at the backend root) is used as CA.
DB_SSL=false

# ── Valkey / Redis ──────────────────────────────────────────────────────────
# Optional. VALKEY_ENABLED=false runs with caching off — every cache call
# degrades to a no-op and reads go straight to Postgres. That is the simplest
# local setup, and the default below.
VALKEY_ENABLED=false
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_TLS=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Localhost and private-LAN origins are always allowed, so local dev needs
# nothing here. CSV of extra origins.
CORS_ALLOWED_ORIGINS=
PUBLIC_ORIGIN=
ADMIN_ORIGIN=

# ── HYFIT Games (athlete + admin) ───────────────────────────────────────────
# Signing key for the module's own athlete/admin JWTs. The app refuses to start
# with NODE_ENV=production while this is left at its dev default.
HFG_JWT_SECRET=hfg-dev-secret-change-me
HFG_ACCESS_TOKEN_TTL=15m
HFG_REFRESH_TOKEN_TTL_DAYS=30

# OTP login. `console` prints the code to the server log instead of sending an
# SMS — the right setting for local work. `msg91` needs the two keys below.
HFG_OTP_PROVIDER=console
HFG_OTP_TTL_MINUTES=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Shared key RaceResult sends as x-api-key on timing pushes. Leave empty and
# the timing guard rejects every push — set it if you exercise that route.
TIMING_API_KEY=

# ── HYFIT Judge (judge + check-in field apps) ───────────────────────────────
# Signing key for the PIN-based field sessions. Same production guard as above.
HJUDGE_SESSION_SECRET=hjudge-dev-secret-change-me

# ── Offline events: this server's role ──────────────────────────────────────
# An event is `online` (the deployment running it also publishes it — today's
# behaviour) or `offline` (a local server at the venue runs it and pushes the
# athletes and results up to prod, which is what the public reads). Both
# deployments run the same code against the same schema, so this says which one
# THIS process is:
#
#   local   sends. It exposes the Sync screen's push panel and runs the timer
#           that pushes standings on an interval.
#   prod    receives. It mints connection codes and accepts pushes, and never
#           pushes anywhere itself. This is the DEFAULT if the variable is
#           unset or unrecognised, because it is the harmless half.
#
# Deliberately not a database row or an admin toggle: an operator who could
# flip prod to `local` on a screen would have an afternoon in which prod tried
# to push its own results somewhere. Changing it means a restart by somebody
# who meant to.
#
# For hyfit-local-server this should be `local`.
HYFIT_NODE_ROLE=local

# How many bytes of JSON one push request may carry. The receiving Nest body
# parser accepts 100 KB by default and neither deployment raises it, so the
# SENDER stays under it and splits a snapshot into as many requests as needed.
# Raise this only alongside the receiver's parser limit — a payload the sender
# is happy with and the receiver rejects is a 413 on every push that no retry
# can clear.
HYFIT_PUSH_MAX_BYTES=80000

# Per-request timeout for a push, in ms. Venue wifi fails slowly rather than
# cleanly, and a push that hangs past its own interval stacks up behind the
# next one.
HYFIT_PUSH_TIMEOUT_MS=20000

# How often the push scheduler wakes up, in ms. It is a tick, not a timer per
# event: on each wake it asks the database which events are due. The per-event
# interval is the dropdown on the Sync screen (0/1/2/3/5/10/20/30/60 minutes),
# so this only bounds how promptly a due push is noticed.
HYFIT_PUSH_TICK_MS=30000

# How many push attempts to keep per event, for the Sync screen's history.
HYFIT_PUSH_RUN_RETENTION=200

# Default lifetime of a connection code minted by a PROD-role server, in hours.
# Ignored on a local node, which mints nothing.
HYFIT_INGEST_TOKEN_HOURS=72
