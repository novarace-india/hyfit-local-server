# HYFIT local backend — copy to .env and adjust. Every variable the copied
# source actually reads is listed here; there are no others.

NODE_ENV=development
PORT=3001

# ── Postgres ────────────────────────────────────────────────────────────────
# Both HYFIT modules open their own pg pool against this database. The
# hyfitgames pool pins every connection to `search_path=hyfit,public`; the
# hyfit-judge pool reads the `hyfit_v2` schema. So one local database carrying
# both schemas is all this needs — see sql/hyfit_schema.sql and
# sql/hyfit_v2_schema.sql.
#
# DB_PASSWORD is the one variable with no fallback: the pool throws on startup
# if it is unset. An empty value is fine for a trust-auth local Postgres.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hyfit_local
# When true, TLS is required and db-ca.pem (at the backend root) is used as CA.
DB_SSL=false

# ── Valkey / Redis ──────────────────────────────────────────────────────────
# Optional. VALKEY_ENABLED=false runs with caching off — every cache call
# degrades to a no-op and reads go straight to Postgres. That is the simplest
# local setup, and the default below.
VALKEY_ENABLED=false
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_TLS=false

# ── CORS ────────────────────────────────────────────────────────────────────
# Localhost and private-LAN origins are always allowed, so local dev needs
# nothing here. CSV of extra origins.
CORS_ALLOWED_ORIGINS=
PUBLIC_ORIGIN=
ADMIN_ORIGIN=

# ── HYFIT Games (athlete + admin) ───────────────────────────────────────────
# Signing key for the module's own athlete/admin JWTs. The app refuses to start
# with NODE_ENV=production while this is left at its dev default.
HFG_JWT_SECRET=hfg-dev-secret-change-me
HFG_ACCESS_TOKEN_TTL=15m
HFG_REFRESH_TOKEN_TTL_DAYS=30

# OTP login. `console` prints the code to the server log instead of sending an
# SMS — the right setting for local work. `msg91` needs the two keys below.
HFG_OTP_PROVIDER=console
HFG_OTP_TTL_MINUTES=5
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Shared key RaceResult sends as x-api-key on timing pushes. Leave empty and
# the timing guard rejects every push — set it if you exercise that route.
TIMING_API_KEY=

# ── HYFIT Judge (judge + check-in field apps) ───────────────────────────────
# Signing key for the PIN-based field sessions. Same production guard as above.
HJUDGE_SESSION_SECRET=hjudge-dev-secret-change-me
