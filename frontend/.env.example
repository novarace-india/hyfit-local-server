# HYFIT local frontend — copy to .env.local (Next loads it automatically).

# Where this Next server proxies /api/* to. Used server-side only, so it can
# stay on localhost even when tablets reach this app over the LAN — which is the
# point of the rewrite: every request the browser makes is same-origin, so the
# backend's session cookies actually stick.
INTERNAL_API_URL=http://localhost:3001

# Only used as a fallback for the rewrite target above. The client never calls
# the backend host directly; api.ts and the judge/check-in clients all use
# same-origin /api paths.
NEXT_PUBLIC_API_URL=http://localhost:3001
